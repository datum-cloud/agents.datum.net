#!/usr/bin/env bash
set -euo pipefail

port="${SMOKE_PORT:-3917}"
log="$(mktemp)"

PORT="$port" bun ./build/server/index.js >"$log" 2>&1 &
pid=$!
trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; rm -f "$log"' EXIT

for _ in $(seq 1 30); do
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "server exited before serving a request:" >&2
    cat "$log" >&2
    exit 1
  fi
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/")" == "200" ]]; then
    echo "server answered GET / with 200"
    exit 0
  fi
  sleep 1
done

echo "server did not answer GET / with 200 within 30s:" >&2
cat "$log" >&2
exit 1
